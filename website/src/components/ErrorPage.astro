---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const spanish = Astro.url.pathname.startsWith(`${import.meta.env.BASE_URL}es/`);
---

<StarlightPage frontmatter={{
  title: spanish ? 'Página no encontrada' : 'Page not found',
  description: spanish ? 'Vuelva a AegisQ o encuentre la documentación que necesita.' : 'Find your way back to AegisQ and its documentation.',
  template: 'splash',
  hero: {},
  pagefind: false,
  editUrl: false,
  tableOfContents: false,
  prev: false,
  next: false,
  head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } }],
}} />
